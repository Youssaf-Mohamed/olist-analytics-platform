/* ============================================================
   01_base.css
   Global styles, variables, typography, and resets
   ============================================================ */

/* ---- Google Fonts (augmented in fonts.css) ---------------- */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap');

/* ====================================================================
   DARK THEME (default)
   ==================================================================== */
:root {
    --bg: #0B0E17;
    --surface: #13172A;
    --surface2: #1A1F35;
    --surface3: #222845;
    --border: #252D47;
    --border2: #2E3A5C;

    /* Glassmorphism tokens */
    --glass-bg: rgba(19, 23, 42, 0.45);
    --glass-bg2: rgba(26, 31, 53, 0.55);
    --glass-border: rgba(255, 255, 255, 0.08);
    --glass-blur: blur(16px);
    --glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);

    /* Accent palette */
    --cyan: #38BDF8;
    --cyan-glow: rgba(56, 189, 248, 0.18);
    --purple: #A78BFA;
    --purple-glow: rgba(167, 139, 250, 0.18);
    --green: #34D399;
    --green-glow: rgba(52, 211, 153, 0.15);
    --amber: #FBBF24;
    --amber-glow: rgba(251, 191, 36, 0.15);
    --red: #F87171;
    --indigo: #818CF8;

    /* Typography */
    --text: #E2E8F0;
    --text-soft: #94A3B8;
    --muted: #4B5A7A;
    --input-bg: #1A1F35;
    --input-color: #E2E8F0;

    /* Sidebar */
    --sidebar-bg: #0E1120;
    --sidebar-w: 260px;
    --sidebar-collapsed: 76px;
    --nav-active-bg: rgba(56, 189, 248, 0.12);
    --nav-hover-bg: rgba(255, 255, 255, 0.05);
    --nav-active-border: var(--cyan);

    /* Misc */
    --font-heading: 'Plus Jakarta Sans', sans-serif;
    --font-body: 'Inter', sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
    --radius: 12px;
    --radius-sm: 8px;
    --transition: 0.22s cubic-bezier(.4, 0, .2, 1);
    --shadow: 0 4px 24px rgba(0, 0, 0, 0.45);
    --shadow-sm: 0 2px 10px rgba(0, 0, 0, 0.3);
}

html[data-theme="light"],
body[data-theme="light"],
#app-container[data-theme="light"] {
    --bg: #F3F6FB;
    --surface: #FFFFFF;
    --surface2: #EEF3FB;
    --surface3: #E2E8F0;
    --border: #D7E0EC;
    --border2: #CBD5E1;
    --glass-bg: rgba(255, 255, 255, 0.72);
    --glass-bg2: rgba(255, 255, 255, 0.82);
    --glass-border: rgba(15, 23, 42, 0.08);
    --glass-shadow: 0 16px 48px rgba(15, 23, 42, 0.08);
    --cyan: #0284C7;
    --cyan-glow: rgba(2, 132, 199, 0.14);
    --purple: #7C3AED;
    --purple-glow: rgba(124, 58, 237, 0.12);
    --green: #059669;
    --green-glow: rgba(5, 150, 105, 0.12);
    --amber: #D97706;
    --amber-glow: rgba(217, 119, 6, 0.12);
    --red: #DC2626;
    --indigo: #4F46E5;
    --text: #0F172A;
    --text-soft: #475569;
    --muted: #94A3B8;
    --input-bg: rgba(255, 255, 255, 0.88);
    --input-color: #0F172A;
    --sidebar-bg: #F8FBFF;
    --nav-active-bg: rgba(2, 132, 199, 0.1);
    --nav-hover-bg: rgba(15, 23, 42, 0.04);
    --shadow: 0 10px 40px rgba(15, 23, 42, 0.09);
    --shadow-sm: 0 4px 18px rgba(15, 23, 42, 0.08);
}



/* ====================================================================
   RESET
   ==================================================================== */
*,
*::before,
*::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html,
body {
    height: 100%;
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    transition: background-color 0.3s ease, color 0.3s ease;
}

/* ====================================================================
   SCROLLBAR
   ==================================================================== */
::-webkit-scrollbar {
    width: 5px;
    height: 5px;
}

::-webkit-scrollbar-track {
    background: transparent;
}

::-webkit-scrollbar-thumb {
    background: var(--border2);
    border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
    background: var(--muted);
}
