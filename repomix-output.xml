    min-height: 54px !important;
    border-radius: 12px !important;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.02) !important;
    overflow: hidden !important;
}

.topbar-date-range .DateInput,
.topbar-date-range .DateInput_input,
.topbar-date-range input {
    background: transparent !important;
    color: #E6EEF8 !important;
}

.topbar-date-range .DateInput {
    width: 140px !important;
    background: transparent !important;
    border: 0 !important;
    border-radius: 0 !important;
}

.topbar-date-range .DateInput:first-of-type {
    border-right: 1px solid rgba(255, 255, 255, 0.08) !important;
}

.topbar-date-range .DateInput_input {
    font-family: var(--font-mono) !important;
    font-size: 0.98rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.2px !important;
    padding: 14px 14px !important;
    border: 0 !important;
    border-radius: 0 !important;
    line-height: 1.2 !important;
}

.topbar-date-range .DateInput_input::placeholder,
.topbar-date-range input::placeholder {
    color: rgba(230, 238, 248, 0.45) !important;
}

.topbar-date-range .DateRangePickerInput_arrow,
.topbar-date-range .DateRangePickerInput_arrow_svg {
    color: rgba(230, 238, 248, 0.6) !important;
    fill: rgba(230, 238, 248, 0.6) !important;
}

.topbar-date-range .DateRangePickerInput_arrow {
    padding: 0 10px !important;
}

.topbar-date-range .DateRangePickerInput_calendarIcon svg,
.topbar-date-range .DateRangePickerInput_clearDates svg {
    fill: rgba(230, 238, 248, 0.6) !important;
}

.topbar-date-range .DateInput_input__focused,
.topbar-date-range .DateInput_input:focus {
    background: rgba(255, 255, 255, 0.04) !important;
    color: #FFFFFF !important;
    border-bottom: 0 !important;
    box-shadow: inset 0 -2px 0 var(--cyan) !important;
}

/* ── Dropdown (Dash dcc.Dropdown with className="dash-dropdown") ── */
.dash-dropdown {
    font-size: 0.95rem !important;
    font-family: var(--font-body) !important;
}

/* Brute force dropdown background */
.dash-dropdown,
.dash-dropdown .Select,
.dash-dropdown .Select-control,
.Select-control,
.dash-dropdown.Select.is-focused>.Select-control,
.dash-dropdown.Select.is-open>.Select-control,
.dash-dropdown.Select.has-value>.Select-control,
.dash-dropdown>div,
.dash-dropdown>div>div,
.dash-dropdown[data-radix-popper-content-wrapper],
div[class*="Select-control"] {
    background: var(--input-bg) !important;
    background-color: var(--input-bg) !important;
}

.dash-dropdown .Select-control {
    border: 1px solid var(--border) !important;
    border-radius: 8px !important;
    transition: all var(--transition) !important;
    min-height: 42px !important;
}

.dash-dropdown .Select.is-focused>.Select-control,
.dash-dropdown .Select.is-open>.Select-control {
    border-color: var(--cyan) !important;
    box-shadow: 0 0 0 2px var(--cyan-glow) !important;
}

.dash-dropdown .Select-menu-outer {
    background-color: #0F1628 !important;
    backdrop-filter: var(--glass-blur) !important;
    -webkit-backdrop-filter: var(--glass-blur) !important;
    border: 1px solid rgba(56, 189, 248, 0.15) !important;
    border-radius: 10px !important;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5) !important;
    z-index: 99999 !important;
    margin-top: 4px !important;
    overflow: visible !important;
}

.dash-dropdown .Select-menu {
    max-height: 280px !important;
    overflow-y: auto !important;
    border-radius: 10px !important;
    background-color: #0F1628 !important;
}

/* Custom scrollbar for list */
.dash-dropdown .Select-menu::-webkit-scrollbar {
    width: 5px;
}

.dash-dropdown .Select-menu::-webkit-scrollbar-track {
    background: transparent;
}

.dash-dropdown .Select-menu::-webkit-scrollbar-thumb {
    background: rgba(56, 189, 248, 0.2);
    border-radius: 4px;
}

.dash-dropdown .Select-menu::-webkit-scrollbar-thumb:hover {
