    _WC_AVAILABLE = True
except ImportError:
    _WC_AVAILABLE = False

dash.register_page(__name__, path="/reviews", name="Reviews", order=2)

# ── Load data once ────────────────────────────────────────────────────────────
DATA_BUNDLE = load_data_bundle()
