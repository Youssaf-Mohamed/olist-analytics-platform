/* ====================================================================
   02_layout.css
   App container, Sidebar structure, Topbar, and Page Headers
   ==================================================================== */

/* ── APP STRUCTURE ── */
#app-container {
    display: flex;
    height: 100vh;
    overflow: hidden;
    font-size: 15px;
    /* Base size bump */
}

/* ── SIDEBAR ── */
#sidebar {
    width: var(--sidebar-w);
    min-width: var(--sidebar-w);
    height: 100vh;
    background-color: var(--sidebar-bg);
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    flex-shrink: 0;
    z-index: 200;
    transition: width var(--transition), min-width var(--transition);
    box-shadow: 2px 0 20px rgba(0, 0, 0, 0.25);
}

/* Collapsed state (toggled by JS) */
#sidebar.collapsed {
    width: var(--sidebar-collapsed);
    min-width: var(--sidebar-collapsed);
}

/* Logo */
#sidebar-logo {
    padding: 22px 18px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    overflow: hidden;
    min-height: 70px;
}

.logo-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    object-fit: contain;
}

.logo-text-wrap {
    overflow: hidden;
    transition: opacity var(--transition), width var(--transition);
}

.logo-text {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.3px;
    white-space: nowrap;
}

.logo-sub {
    font-family: var(--font-body);
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.35);
    text-transform: uppercase;
    letter-spacing: 1.2px;
    white-space: nowrap;
    margin-top: 1px;
    display: block;
}

.sidebar-collapsed .logo-text-wrap {
    opacity: 0;
    width: 0;
}

/* Nav Links */
#sidebar-nav {
    display: flex;
    flex-direction: column;
    padding: 12px 10px;
    gap: 3px;
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
}

.nav-link {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 13px 16px;
    border-radius: var(--radius-sm);
    color: rgba(255, 255, 255, 0.50);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    transition: all var(--transition);
    cursor: pointer;
    position: relative;
    white-space: nowrap;
    overflow: hidden;
}

.nav-link:hover {
    color: rgba(255, 255, 255, 0.9);
    background-color: var(--nav-hover-bg);
    text-decoration: none;
}

.nav-link.active {
    color: var(--cyan);
    background-color: var(--nav-active-bg);
    font-weight: 600;
}

.nav-link.active::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 60%;
    background: var(--cyan);
    border-radius: 3px 0 0 3px;
}

.nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 22px;
    height: 22px;
}

.nav-label {
    flex: 1;
    transition: opacity var(--transition);
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Tooltip for collapsed sidebar */
.nav-link:hover::before {
    display: none;
}

#sidebar.collapsed .nav-link:hover::before {
    content: attr(data-label);
    display: block;
    position: absolute;
    left: calc(var(--sidebar-collapsed) + 8px);
    top: 50%;
    transform: translateY(-50%);
    background: var(--surface3);
    color: var(--text);
    font-size: 0.78rem;
    padding: 5px 10px;
    border-radius: 6px;
    border: 1px solid var(--border2);
    white-space: nowrap;
    z-index: 999;
    box-shadow: var(--shadow-sm);
    pointer-events: none;
}

#sidebar.collapsed .nav-label {
    opacity: 0;
    width: 0;
    overflow: hidden;
}

/* Sidebar Toggle Button */
#sidebar-toggle {
    padding: 12px 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
}

#sidebar-toggle button {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.5);
    border-radius: 6px;
    width: 30px;
    height: 30px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition);
    font-size: 0;
}

#sidebar-toggle button:hover {
    background: rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.9);
}

/* Sidebar Footer */
#sidebar-footer {
    padding: 10px 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.2);
    font-family: var(--font-mono);
    white-space: nowrap;
    overflow: hidden;
}

#sidebar.collapsed #sidebar-footer {
    opacity: 0;
}

/* ── MAIN CONTENT AREA ── */
#main-content {
    flex: 1;
    height: 100vh;
    overflow-y: auto;
    overflow-x: hidden;
    background-color: var(--bg);
    padding: 28px 32px;
    transition: background-color 0.3s ease;
    position: relative;
}

/* ── TOPBAR ── */
#topbar {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    margin-bottom: 24px;
    position: sticky;
    top: 0;
    z-index: 90;
    padding-top: 4px;
