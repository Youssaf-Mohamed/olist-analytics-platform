.DayPickerNavigation_svg {
    fill: var(--text-soft) !important;
    width: 16px !important;
    height: 15px !important;
}

.DayPickerNavigation_button:hover .DayPickerNavigation_svg {
    fill: var(--cyan) !important;
}

/* ── Clear date button ── */
.DateRangePickerInput_clearDates {
    background-color: transparent !important;
    background: transparent !important;
    padding: 4px !important;
}

.DateRangePickerInput_clearDates svg {
    fill: var(--muted) !important;
}

.DateRangePickerInput_clearDates:hover svg {
    fill: var(--red) !important;
}

/* ── Calendar icon ── */
.DateRangePickerInput_calendarIcon {
    padding: 4px 8px !important;
}

.DateRangePickerInput_calendarIcon svg {
    fill: var(--muted) !important;
}

/* Topbar-specific DatePicker polish */
.topbar-date-range,
.topbar-date-range .DateRangePicker,
.topbar-date-range .DateRangePickerInput,
.topbar-date-range .DateRangePickerInput__withBorder {
    width: 100% !important;
